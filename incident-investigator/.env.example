# Required to execute live agent runs. Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Supabase/Postgres direct connection. Use the pooler/direct URI approved for your project.
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# LangChain/LangGraph will emit actual model/tool/graph traces when these are present.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=incident-investigator-demo

# Demo safety defaults. D4 reads only the approved local repository and deployment fixture paths;
# D3/D5/D6 use seeded Supabase source records.
APP_ENV=development
MAX_AGENT_ROUNDS=3
MAX_CRITIC_FOLLOWUPS=2
MAX_TOOL_ROWS=12

# Optional overrides for the local code/deployment connector.
REFERENCE_REPOSITORY_PATH=example-systems/opentelemetry-demo
DEPLOYMENT_FIXTURE_PATH=demo-fixtures/deployments
